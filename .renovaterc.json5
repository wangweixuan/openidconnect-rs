{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  timezone: "Asia/Shanghai",
  baseBranches: ["renovate-base"],
  rangeStrategy: "bump",
  automergeStrategy: "rebase",
  platformAutomerge: true,
  assigneesFromCodeOwners: false,

  lockFileMaintenance: {
    schedule: ["* * 1 * *"],
    automerge: true,
  },

  packageRules: [
    {
      groupName: "non-major dependencies",
      groupSlug: "non-major",
      matchPackageNames: ["*"],
      matchUpdateTypes: ["minor", "patch", "pin", "digest", "pinDigest"],
      automerge: true,
    },
    {
      description: "Keep crypto dependencies compatible with the supported MSRV and APIs",
      matchPackageNames: ["rand"],
      allowedVersions: "<0.9.0",
    },
    {
      description: "Keep crypto dependencies compatible with the supported MSRV and APIs",
      matchPackageNames: ["hmac"],
      allowedVersions: "<0.13.0",
    },
    {
      description: "Keep crypto dependencies compatible with the supported MSRV and APIs",
      matchPackageNames: ["sha2"],
      allowedVersions: "<0.11.0",
    },
    {
      description: "Keep crypto dependencies compatible with the supported MSRV and APIs",
      matchPackageNames: ["p256", "p384"],
      allowedVersions: "<0.14.0",
    },
  ],
}
